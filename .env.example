# ==============================================================================
# Animal Metrology Computer Vision - Environment Configuration
# ==============================================================================

# Segmentation Model (Primary: YOLOv8-seg for animal contour instance segmentation)
MODEL_WEIGHTS_PATH=models/yolov8n-seg.pt
SEG_MODEL_WEIGHTS_PATH=models/yolov8n-seg.pt

# Keypoint/Pose Model (Auxiliary: for eye localization within segmented animal masks)
POSE_MODEL_WEIGHTS_PATH=models/animal_eye_pose.pt
POSE_KEYPOINT_CONF_THRESHOLD=0.1
POSE_CROP_MARGIN=0.08

# Metrology Metric Scaling Factor
# Example only; calibrate this value for the camera and measurement plane.
PIXEL_TO_MM_SCALE=0.15

# Inference Thresholds
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
# Leave empty for Ultralytics automatic device selection, or set to 0/cpu.
DEVICE=

# Output Configuration
OUTPUT_CSV_PATH=outputs/measurement_results.csv
ANNOTATED_OUTPUT_DIR=outputs/annotated

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
MAX_UPLOAD_SIZE_MB=10

# Security & Authentication (Demo API Key)
API_KEY=metrology-demo-key-2026
